# P8/P9 — données sensibles / locales. NE PAS COMMITTER.
#
# Installation : cp .env.example .env  —  remplir  —  chmod 600 .env
# Absent le fichier, les valeurs par défaut s'appliquent (l'appli
# démarre sans config).

# Cache (P8) : répertoire du cache persisté (défaut ~/.cache/lab_tp)
#CACHE_DIR=

# P9 — IA générative (provider très probablement ProxyIAg, qui gère
# les quotas en nombre de requêtes et en volume de tokens)
#IA_PROVIDER=
#IA_MODEL=
#IA_API_KEY=
