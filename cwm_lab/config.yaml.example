# P8 — configuration de l'outil TP (paramètres NON sensibles).
#
# Installation : cp config.yaml.example config.yaml  —  compléter
#  —  chmod 600 config.yaml
# Absent le fichier, les valeurs par défaut ci-dessous s'appliquent
# (l'appli démarre sans config). Format YAML plat (cle: valeur).

# Rétention du cache disque (défaut 7 jours) — formats : s, m, h, d
#ttl_disk: 7d

# Rétention du cache mémoire (défaut 5 minutes)
#ttl_memory: 5m

# Taille totale maximale du cache disque, en Mo (défaut 200)
#max_disk_mb: 200

# Nombre d'entrées du cache mémoire (défaut 64)
#memory_entries: 64

# P9 — IA générative : quotas de séance (comptés côté backend,
# persistés avec le cache, réinitialisés chaque jour). Le quota de
# ProxyIAg est celui d'une clé unique, commune à tous les étudiants
# : c'est ici qu'un étudiant est empêché d'épuiser celui des autres.
#
# Requêtes par jour (défaut 30)
#ia_max_requests: 30
#
# Tokens par jour (défaut 100000) — usage lu dans la réponse du proxy
#ia_max_tokens: 100000
#
# Régénération bornée en cas de contrôle refusé (défaut 3)
#ia_max_attempts: 3
#
# Délai d'appel du proxy, en secondes (défaut 120 — une génération
# complète prend 30–60 s selon la taille demandée)
#ia_timeout: 120
#
# Longueur maximale de la réponse du modèle, en tokens (défaut 4000 —
# 2000 se coupait en pleine génération dès ~40 faits)
#ia_max_tokens_response: 4000
