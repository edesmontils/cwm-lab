# =====================================================================
# Base de connaissances « Recettes & contre-indications » — TP Web sémantique
# ---------------------------------------------------------------------
# Fichier 1/4 : les INGRÉDIENTS et leur composition (100 g).
# Espace de nom ingr: — indépendant de rec: (recettes) et de med: (médical).
#
# Deux natures de composition :
#   - qualitative : ingr:contientAllergene  (le composant est présent ou non)
#   - quantitative : 9 axes de composition, valeur pour 100 g :
#       sodium, purines, potassium (mg) ; sucre, gras saturés, fructane (g) ;
#       cholestérol, histamine (mg) ; alcool (g).
#
# Axes « en service » dans les règles (regles.n3) :
#   sodium, purines, sucre, gras saturés, histamine, alcool.
# Axes « réservés aux exercices » (les données sont déjà là) :
#   potassium (insuffisance rénale), fructane (IIH), cholestérol
#   (hypercholestérolémie) — voir enonce.md et corriges/.
#
# Les libellés (rdfs:label) sont bilingues (@fr / @en) : l'interface
# affiche celui de sa langue (repli : sans étiquette, puis le premier
# libellé présent). NB : ingr:arachide, ingr:lait, ingr:oeuf et
# ingr:poisson sont À LA FOIS composant allergène et ingrédient —
# même URI, deux libellés par langue (le premier l'emporte à l'affichage).
#
# Valeurs : ordres de grandeur approximatifs, choisis pour le TP.
# =====================================================================
@prefix ingr: <http://example.org/ingredient#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ---------------- Types (ontologie bilingue) ----------------
ingr:Allergene a rdfs:Class ; rdfs:label "allergène"@fr , "allergen"@en .
ingr:Cereale   a rdfs:Class ; rdfs:label "céréale"@fr , "cereal grain"@en .
ingr:Olea      a rdfs:Class ; rdfs:label "oléagineux"@fr , "nut / seed"@en .
ingr:Laitier   a rdfs:Class ; rdfs:label "produit laitier"@fr , "dairy product"@en .
ingr:Oeuf      a rdfs:Class ; rdfs:label "œuf"@fr , "egg"@en .
ingr:Poisson   a rdfs:Class ; rdfs:label "poisson"@fr , "fish"@en .
ingr:Condiment a rdfs:Class ; rdfs:label "condiment"@fr , "condiment"@en .
ingr:Viande    a rdfs:Class ; rdfs:label "viande"@fr , "meat"@en .
ingr:Legumineuse a rdfs:Class ; rdfs:label "légumineuse"@fr , "legume"@en .
ingr:Legume    a rdfs:Class ; rdfs:label "légume"@fr , "vegetable"@en .
ingr:Boisson   a rdfs:Class ; rdfs:label "boisson"@fr , "beverage"@en .

# ---------------- Propriétés de composition ----------------
# 100 g : la valeur est par 100 g d'ingrédient.
ingr:contientAllergene a rdfs:Property ;
  rdfs:label "contient l'allergène"@fr , "contains allergen"@en .
ingr:contientSodium a rdfs:Property ;
  rdfs:label "sodium (mg/100 g)"@fr , "sodium (mg/100 g)"@en .
ingr:contientPurines a rdfs:Property ;
  rdfs:label "purines (mg/100 g)"@fr , "purines (mg/100 g)"@en .
ingr:contientSucre a rdfs:Property ;
  rdfs:label "sucre (g/100 g)"@fr , "sugar (g/100 g)"@en .
ingr:contientPotassium a rdfs:Property ;
  rdfs:label "potassium (mg/100 g)"@fr , "potassium (mg/100 g)"@en .
ingr:contientGrasSature a rdfs:Property ;
  rdfs:label "gras saturés (g/100 g)"@fr , "saturated fat (g/100 g)"@en .
ingr:contientCholestrol a rdfs:Property ;
  rdfs:label "cholestérol (mg/100 g)"@fr , "cholesterol (mg/100 g)"@en .
ingr:contientHistamine a rdfs:Property ;
  rdfs:label "histamine (mg/100 g)"@fr , "histamine (mg/100 g)"@en .
ingr:contientAlcool a rdfs:Property ;
  rdfs:label "alcool (g/100 g)"@fr , "alcohol (g/100 g)"@en .
ingr:contientFructane a rdfs:Property ;
  rdfs:label "fructane (g/100 g)"@fr , "fructan (g/100 g)"@en .

# ---------------- Allergènes (composants qualitatifs) ----------------
ingr:gluten   a ingr:Allergene ; rdfs:label "gluten"@fr , "gluten"@en .
ingr:arachide a ingr:Allergene ; rdfs:label "arachide"@fr , "peanut"@en .
ingr:lait     a ingr:Allergene ; rdfs:label "lait"@fr , "milk"@en .
ingr:oeuf     a ingr:Allergene ; rdfs:label "œuf"@fr , "egg"@en .
ingr:poisson  a ingr:Allergene ; rdfs:label "poisson"@fr , "fish"@en .

# ---------------- Ingrédients ----------------
# Unités : sodium, purines, potassium, cholestérol, histamine en mg/100 g ;
#          sucre, gras saturés, fructane, alcool en g/100 g.

# -- Céréales et dérivés --
ingr:farine a ingr:Cereale ; rdfs:label "farine de blé"@fr , "wheat flour"@en ;
  ingr:contientAllergene ingr:gluten ;
  ingr:contientSodium 2 ; ingr:contientPurines 15 ; ingr:contientSucre 1 ;
  ingr:contientPotassium 150 ; ingr:contientGrasSature 1 ;
  ingr:contientCholestrol 0 ; ingr:contientHistamine 0 ;
  ingr:contientAlcool 0 ; ingr:contientFructane 2 .

ingr:biscuitSavoiard a ingr:Cereale ; rdfs:label "biscuit savoyard"@fr , "sponge biscuit"@en ;
  ingr:contientAllergene ingr:gluten ;
  ingr:contientAllergene ingr:oeuf ;
  ingr:contientSodium 35 ; ingr:contientPurines 10 ; ingr:contientSucre 25 ;
  ingr:contientPotassium 100 ; ingr:contientGrasSature 1.5 ;
  ingr:contientCholestrol 15 ; ingr:contientHistamine 0 ;
  ingr:contientAlcool 0 ; ingr:contientFructane 1 .

# Gluten « sans » : le gluten n'est pas dans la composition, mais la
# ligne de fabrication est partagée — la contamination croisée est
# modélisée comme présence du composant (cf. enonce.md, exo 5).
ingr:farineSF a ingr:Cereale ; rdfs:label "farine « sans gluten » (ligne partagée)"@fr , "'gluten-free' flour (shared line)"@en ;
  ingr:contientAllergene ingr:gluten ;
  ingr:contientSodium 10 ; ingr:contientPurines 5 ; ingr:contientSucre 2 ;
  ingr:contientPotassium 100 ; ingr:contientGrasSature 0 ;
  ingr:contientCholestrol 0 ; ingr:contientHistamine 0 ;
  ingr:contientAlcool 0 ; ingr:contientFructane 0.3 .

# -- Fruits à coque / oléagineux --
# NB : même URI que l'allergène ingr:arachide — un second libellé
# (le premier l'emporte à l'affichage).
ingr:arachide a ingr:Olea ; rdfs:label "pâte d'arachide"@fr , "peanut butter"@en ;
  ingr:contientAllergene ingr:arachide ;
  ingr:contientSodium 5 ; ingr:contientPurines 200 ; ingr:contientSucre 6 ;
  ingr:contientPotassium 700 ; ingr:contientGrasSature 5 ;
  ingr:contientCholestrol 0 ; ingr:contientHistamine 10 ;
  ingr:contientAlcool 0 ; ingr:contientFructane 0.3 .

