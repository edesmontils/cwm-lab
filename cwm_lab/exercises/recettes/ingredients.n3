# =====================================================================
# Base de connaissances « Recettes & contre-indications » — TP Web sémantique
# ---------------------------------------------------------------------
# Fichier 1/4 : les INGRÉDIENTS et leur composition (100 g).
# Espace de nom ingr: — indépendant de rec: (recettes) et de med: (médical).
#
# Deux natures de composition :
#   - qualitative : ingr:contientAllergene  (le composant est présent ou non)
#   - quantitative : 9 axes de composition, valeur pour 100 g :
#       sodium, purines, potassium (mg) ; sucre, gras saturés, fructane (g) ;
#       cholestérol, histamine (mg) ; alcool (g).
#
# Axes « en service » dans les règles (regles.n3) :
#   sodium, purines, sucre, gras saturés, histamine, alcool.
# Axes « réservés aux exercices » (les données sont déjà là) :
#   potassium (insuffisance rénale), fructane (IIH), cholestérol
#   (hypercholestérolémie) — voir enonce.md et corriges/.
#
# Valeurs : ordres de grandeur approximatifs, choisis pour le TP.
# =====================================================================
@prefix ingr: <http://example.org/ingredient#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ---------------- Allergènes (composants qualitatifs) ----------------
ingr:gluten   a ingr:Allergene ; rdfs:label "gluten"@fr .
ingr:arachide a ingr:Allergene ; rdfs:label "arachide"@fr .
ingr:lait     a ingr:Allergene ; rdfs:label "lait"@fr .
ingr:oeuf     a ingr:Allergene ; rdfs:label "œuf"@fr .
ingr:poisson  a ingr:Allergene ; rdfs:label "poisson"@fr .

# ---------------- Ingrédients ----------------
# Unités : sodium, purines, potassium, cholestérol, histamine en mg/100 g ;
#          sucre, gras saturés, fructane, alcool en g/100 g.

# -- Céréales et dérivés --
ingr:farine a ingr:Cereale ; rdfs:label "farine de blé"@fr ;
  ingr:contientAllergene ingr:gluten ;
  ingr:contientSodium 2 ; ingr:contientPurines 15 ; ingr:contientSucre 1 ;
  ingr:contientPotassium 150 ; ingr:contientGrasSature 1 ;
  ingr:contientCholestrol 0 ; ingr:contientHistamine 0 ;
  ingr:contientAlcool 0 ; ingr:contientFructane 2 .

ingr:biscuitSavoiard a ingr:Cereale ; rdfs:label "biscuit savoyard"@fr ;
  ingr:contientAllergene ingr:gluten ;
  ingr:contientAllergene ingr:oeuf ;
  ingr:contientSodium 35 ; ingr:contientPurines 10 ; ingr:contientSucre 25 ;
  ingr:contientPotassium 100 ; ingr:contientGrasSature 1.5 ;
  ingr:contientCholestrol 15 ; ingr:contientHistamine 0 ;
  ingr:contientAlcool 0 ; ingr:contientFructane 1 .

# Gluten « sans » : le gluten n'est pas dans la composition, mais la
# ligne de fabrication est partagée — la contamination croisée est
# modélisée comme présence du composant (cf. enonce.md, exo 5).
ingr:farineSF a ingr:Cereale ; rdfs:label "farine « sans gluten » (ligne partagée)"@fr ;
  ingr:contientAllergene ingr:gluten ;
  ingr:contientSodium 10 ; ingr:contientPurines 5 ; ingr:contientSucre 2 ;
  ingr:contientPotassium 100 ; ingr:contientGrasSature 0 ;
  ingr:contientCholestrol 0 ; ingr:contientHistamine 0 ;
  ingr:contientAlcool 0 ; ingr:contientFructane 0.3 .

# -- Fruits à coque / oléagineux --
ingr:arachide a ingr:Olea ; rdfs:label "pâte d'arachide"@fr ;
  ingr:contientAllergene ingr:arachide ;
  ingr:contientSodium 5 ; ingr:contientPurines 200 ; ingr:contientSucre 6 ;
  ingr:contientPotassium 700 ; ingr:contientGrasSature 5 ;
  ingr:contientCholestrol 0 ; ingr:contientHistamine 10 ;
  ingr:contientAlcool 0 ; ingr:contientFructane 0.3 .

